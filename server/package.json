{
  "name": "bugboard-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BugBoard API Server — Express & Mongoose Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "dev:mem": "node src/dev-server.js",
    "test": "node --test tests/foundation.test.js tests/api.test.js",
    "test:auth": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles tests/auth.test.js",
    "test:phase3": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles --testTimeout=30000 tests/project.test.js tests/issue.test.js",
    "test:phase4": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles tests/phase4.test.js",
    "test:bonus": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles tests/bonus.test.js",
    "test:users": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles tests/user-management.test.js",
    "test:password": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles tests/password-management.test.js",
    "test:hunt": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles tests/deep-hunt.test.js",
    "test:all": "npm run test && npm run test:auth && npm run test:password && npm run test:phase3 && npm run test:phase4 && npm run test:bonus && npm run test:users && npm run test:hunt",
    "seed": "node src/utils/seed.js",
    "migrate:employee-ids": "node src/utils/migrate-employee-ids.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

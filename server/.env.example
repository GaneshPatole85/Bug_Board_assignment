# ==============================================================================
# BugBoard Backend — Server Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Native / Local MongoDB or MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/bugboard

# Allowed Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Structured Logging Level (pino: trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Rate Limiter Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# Reserved for Phase 2 (Authentication & JWT)
# ==============================================================================
# JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
# JWT_EXPIRES_IN=1d

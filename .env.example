# ==============================================================================
# BugBoard — Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# NOTE: Never commit actual .env files containing real secrets to version control.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database (Native / Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/bugboard

# Client Application URL (for CORS validation)
CLIENT_URL=http://localhost:5173

# Logging Configuration (pino: trace, debug, info, warn, error, fatal)
LOG_LEVEL=info


# Rate Limiting Configuration (express-rate-limit scaffold)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Client-Side API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Authentication & JWT
JWT_SECRET=dev_jwt_secret_key_change_in_production_min_32_chars!
JWT_EXPIRES_IN=1d

# Email & Notification Settings (SMTP / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bugboard.test

# Object Storage & Attachments (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword
S3_BUCKET=bugboard-attachments


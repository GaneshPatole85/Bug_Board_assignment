# ==============================================================================
# BugBoard — Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# NOTE: Never commit actual .env files containing real secrets to version control.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Connection (Native Local, Docker, or MongoDB Atlas)
# Option 1 (Local Native / Docker):
MONGODB_URI=mongodb://127.0.0.1:27017/bugboard
# Option 2 (MongoDB Atlas Cloud Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bugboard?retryWrites=true&w=majority&appName=Cluster0
# NOTE: Treat Atlas connection strings with credentials as confidential secrets; never commit them.

# Client Application URL (for CORS validation)
CLIENT_URL=http://localhost:5173

# Logging Configuration (pino: trace, debug, info, warn, error, fatal)
LOG_LEVEL=info


# Rate Limiting Configuration (express-rate-limit scaffold)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Client-Side API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Authentication & JWT
JWT_SECRET=dev_jwt_secret_key_change_in_production_min_32_chars!
JWT_EXPIRES_IN=1d

# Email & Notification Settings (SMTP / Gmail / Mailpit)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gpatole473@gmail.com
SMTP_PASS=qtzh ofdj yaui etvl
SMTP_FROM=gpatole473@gmail.com

# Object Storage & Attachments (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword
S3_BUCKET=bugboard-attachments

# Administrator Account Configuration (.env Controlled)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@bugboard.test
ADMIN_PASSWORD=Password123!
ADMIN_EMPLOYEE_ID=ADM-0001
ADMIN_DEPARTMENT=Platform Operations


